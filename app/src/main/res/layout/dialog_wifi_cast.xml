<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cast_wifi_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/cast_wifi_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/ivQrCode"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginTop="14dp"
        android:background="#FFFFFF"
        android:contentDescription="Mã QR trình chiếu Wi-Fi"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvCastUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#EFF6FF"
        android:gravity="center"
        android:padding="10dp"
        android:text="http://192.168.1.100:8080"
        android:textColor="@color/brand_primary"
        android:textIsSelectable="true"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleWifiServer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_stop_wifi_cast"
            android:textAllCaps="false"
            app:backgroundTint="@color/badge_pdf"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDialog"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_close"
            android:textAllCaps="false"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
