<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/extIvPdfPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Màn hình chiếu PDF"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <WebView
        android:id="@+id/extWebOfficeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.doccast.presenter.ui.AnnotationOverlayView
        android:id="@+id/extAnnotationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/extBlackoutCurtain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />
</FrameLayout>
